# PostgreSQL connection string used by the service and by `sqlx::test`.
DATABASE_URL=postgres://postgres:pw@localhost:5432/agent_api

# Administrator secret. Presented in the `x-admin-key` header to manage keys.
# Must be non-empty. Generate a strong random value in production.
ADMIN_API_KEY=change-me-to-a-long-random-secret

# Address the HTTP server binds to (optional; defaults to 0.0.0.0:3000).
BIND_ADDR=0.0.0.0:3000

# Maximum pooled DB connections (optional; defaults to 5).
DB_MAX_CONNECTIONS=5
